FWS_MODEL_NAME=ViT-B-16
FWS_PRETRAINED=laion2b_s34b_b88k
FWS_DEVICE=cpu
FWS_BATCH_SIZE=32
FWS_METADATA_PATH=data/metadata/final_search_assets.jsonl
FWS_IMAGE_ROOT=.
FWS_INDEX_PATH=storage/indexes/weapons.faiss
FWS_INDEX_IDS_PATH=storage/indexes/weapon_ids.json
FWS_LOG_PATH=storage/logs/search.jsonl
# 상대경로는 저장소 루트 기준입니다. 공유 캐시가 필요하면 각 PC의 절대경로로 바꾸세요.
FWS_MODEL_CACHE=.cache/openclip
# [미사용] 검색 서비스가 .cache/translation을 하드코딩해 이 값은 무시됩니다.
# FWS_TRANSLATION_CACHE=.cache/translation
# 쉼표로 구분한 명시적 프론트엔드 origin만 허용합니다. 빈 값이면 CORS를 끕니다.
FWS_CORS_ORIGINS=
# true로 켜면 서버가 요청을 받기 전에 한국어 번역 모델을 미리 로딩합니다.
# 첫 한국어 검색이 모델 다운로드·초기화 시간만큼 느려지는 것을 막아 줍니다.
# 기본값은 false입니다. 로컬 개발에서는 서버를 자주 재시작하므로 꺼두는 편이
# 편하지만, 운영 배포에서는 true로 켜서 실행하세요(Dockerfile은 이미 켜져 있음).
FWS_PRELOAD_TRANSLATION_MODEL=false
