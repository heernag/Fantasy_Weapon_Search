# 줄바꿈 정책
#
# storage/indexes/service_manifest.json 이 아래 파일들의 SHA-256을 검증한다.
# git이 체크아웃할 때 줄바꿈을 바꾸면 바이트가 달라져 해시가 어긋나고,
# 서버가 기동 단계에서 멈춘다. 그래서 데이터 파일은 변환 대상에서 뺀다.
#   - embeddings/**/asset_ids.json
#   - data/metadata/final_search_assets.jsonl

* text=auto

# 해시 검증 대상과 같은 형식의 데이터 파일
*.json    -text
*.jsonl   -text

# 바이너리 산출물
*.npy     binary
*.pt      binary
*.faiss   binary
*.png     binary

# 윈도우 실행 스크립트는 CRLF 유지
*.cmd     text eol=crlf
*.ps1     text eol=crlf
